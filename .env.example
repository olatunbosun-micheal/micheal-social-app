# -------------------------------------------------------------
# Personal Communication Gateway - Environment Configuration
# -------------------------------------------------------------

# Server Port
PORT=4000
NODE_ENV=development

# JWT Secret for Session & Guest Authentication
JWT_SECRET=gateway-super-secret-key-change-in-production

# Owner Credentials (Bootstrapped on first run)
OWNER_NAME="Micheal"
OWNER_EMAIL="micheal@gateway.internal"
OWNER_PASSWORD="admin_change_me_123"

# -------------------------------------------------------------
# Supabase (Storage for Voice Notes & Database)
# -------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and anon / service_role key
# 4. In Supabase Dashboard -> Storage -> Create a public bucket named "gateway-media"

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=gateway-media

# Optional Supabase Database direct connection string (Project Settings -> Database)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# -------------------------------------------------------------
# (Alternative) Cloudflare R2 / S3
# -------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=gateway-media
# R2_PUBLIC_URL=
